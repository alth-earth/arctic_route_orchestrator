{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arctic-route/orchestrator/planning-coverage-preflight-v1.schema.json",
  "title": "Planning coverage preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "corridor_id",
    "generation_id",
    "input_revision",
    "frames_expected",
    "frames_checked",
    "gate_passed",
    "gate_semantics",
    "worst_frame",
    "frames"
  ],
  "properties": {
    "schema_version": {"const": "orchestrator.planning-coverage-preflight.v1"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "corridor_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "integer", "minimum": 0},
    "input_revision": {"type": "integer", "minimum": 0},
    "frames_expected": {"type": "integer", "minimum": 1},
    "frames_checked": {"type": "integer", "minimum": 1},
    "gate_passed": {"type": "boolean"},
    "gate_semantics": {"type": "string", "minLength": 1},
    "worst_frame": {"$ref": "#/$defs/frameSummary"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frameSummary"}
    }
  },
  "$defs": {
    "frameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "valid_time",
        "total_nodes",
        "hard_nodes",
        "land_nodes",
        "data_unavailable_nodes",
        "other_hard_nodes",
        "navigable_nodes",
        "unknown_navigable_nodes",
        "finite_coverage_percent",
        "missing_input_variable_counts"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "valid_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "total_nodes": {"type": "integer", "minimum": 1},
        "hard_nodes": {"type": "integer", "minimum": 0},
        "land_nodes": {"type": "integer", "minimum": 0},
        "data_unavailable_nodes": {"type": "integer", "minimum": 0},
        "other_hard_nodes": {"type": "integer", "minimum": 0},
        "navigable_nodes": {"type": "integer", "minimum": 0},
        "unknown_navigable_nodes": {"type": "integer", "minimum": 0},
        "finite_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "missing_input_variable_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
