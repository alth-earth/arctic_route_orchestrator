{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arctic-route.local/schemas/orchestrator/execution-spec-v1.schema.json",
  "title": "A-B-C execution specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "generation_id",
    "input_revision",
    "generated_at",
    "planning_contract",
    "max_snap_km",
    "replan_after_hours",
    "per_stage_timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestrator.execution-spec.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "integer",
      "minimum": 0
    },
    "input_revision": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "planning_contract": {
      "enum": [
        "cd.route-plan.v2",
        "cd.four-layer-route-plan-set.v3"
      ]
    },
    "max_snap_km": {
      "type": "number",
      "minimum": 0
    },
    "replan_after_hours": {
      "type": "integer",
      "minimum": 1
    },
    "per_stage_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
